{
  "name": "devhub",
  "version": "0.1.0",
  "description": "DevHub - Windows new machine one-click setup tool",
  "main": "dist-electron/main.js",
  "author": "DevHub",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "tsup --config tsup.config.ts --watch",
    "dev:electron": "wait-on tcp:5173 file:dist-electron/main.js && node scripts/run-electron-dev.cjs",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsup --config tsup.config.ts",
    "release:gate": "npm run typecheck && npm run test && node scripts/check-release-readiness.cjs",
    "dist": "node scripts/build-dist.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.7",
    "wait-on": "^8.0.3"
  }
}
